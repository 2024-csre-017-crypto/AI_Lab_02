    "#-----Task 1:Greater Number----\n",
    "#Input two integers and compare\n",
    "\n",
    "a=int(input(\"Enter first number:\"))\n",
    "b=int(input(\"Enter second number:\"))\n",
    "\n",
    "if a>b:\n",
    "    print(\"Greater number:\",a)\n",
    "elif b>a:\n",
    "    print(\"Greater number:\",b)\n",
    "else:\n",
    "    print(\"Both are equal\",a)"
   ]
