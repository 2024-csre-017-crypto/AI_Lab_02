    "# --- Task 3: Even or Odd --\n",
    "n = int(input(\"Enter a number: \"))\n",
    "if n % 2 == 0:\n",
    "    print(n, \"is Even\")\n",
    "else:\n",
    "    print(n, \"is Odd\")"
